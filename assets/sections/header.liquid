{% comment %}
  Header Section
  
  This section contains the global site header with:
  - Announcement bar
  - Logo
  - Desktop navigation with dropdowns
  - Search overlay
  - Account link
  - Cart with count
  - Mobile menu
{% endcomment %}

<header class="header" role="banner" data-section-type="header" data-section-id="{{ section.id }}">
  
  {% comment %} ANNOUNCEMENT BAR {% endcomment %}
  {% if section.settings.show_announcement %}
    <div class="announcement-bar" role="complementary" aria-label="Announcements">
      <div class="container">
        <p class="announcement-bar__text">
          {{ section.settings.announcement_text }}
          {% if section.settings.announcement_link_text != blank %}
            <a href="{{ section.settings.announcement_link }}" class="announcement-bar__link">
              {{ section.settings.announcement_link_text }}
            </a>
          {% endif %}
        </p>
      </div>
    </div>
  {% endif %}
  
  {% comment %} MAIN HEADER {% endcomment %}
  <div class="header__main">
    <div class="container header__container">
      
      {% comment %} LOGO {% endcomment %}
      <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} - Home">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | img_url: '140x' }}"
            srcset="
              {{ section.settings.logo | img_url: '140x' }} 1x,
              {{ section.settings.logo | img_url: '280x' }} 2x
            "
            alt="{{ shop.name }}"
            width="140"
            height="{{ 140 | divided_by: section.settings.logo.aspect_ratio | round }}"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          <span class="header__logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
      
      {% comment %} DESKTOP NAVIGATION {% endcomment %}
      {% if section.blocks.size > 0 %}
        <nav class="header__nav" aria-label="Main navigation">
          <ul class="header__nav-list">
            {% for block in section.blocks %}
              {% if block.type == 'menu_item' %}
                <li class="header__nav-item" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link }}" class="header__nav-link">
                    {{ block.settings.title }}
                  </a>
                  
                  {% comment %} DROPDOWN / MEGA MENU {% endcomment %}
                  {% if block.settings.show_dropdown %}
                    <div class="header__dropdown" role="menu">
                      <div class="container">
                        <div class="header__dropdown-grid">
                          {% for i in (1..3) %}
                            {% capture column_title %}dropdown_col_{{ i }}_title{% endcapture %}
                            {% capture column_links %}dropdown_col_{{ i }}_links{% endcapture %}
                            
                            {% if block.settings[column_title] != blank %}
                              <div class="header__dropdown-col">
                                <h4 class="header__dropdown-heading">{{ block.settings[column_title] }}</h4>
                                <ul>
                                  {% assign links = block.settings[column_links] | newline_to_br | split: '<br />' %}
                                  {% for link in links %}
                                    {% assign link_parts = link | split: '|' %}
                                    <li>
                                      <a href="{{ link_parts[1] | strip }}">
                                        {{ link_parts[0] | strip }}
                                      </a>
                                    </li>
                                  {% endfor %}
                                </ul>
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
      
      {% comment %} HEADER ACTIONS {% endcomment %}
      <div class="header__actions">
        
        {% comment %} SEARCH TOGGLE {% endcomment %}
        <button
          class="header__action-btn"
          aria-label="Open search"
          data-search-toggle
          type="button"
        >
          {% render 'icon-search', class: 'icon' %}
        </button>
        
        {% comment %} ACCOUNT LINK {% endcomment %}
        <a
          href="{{ routes.account_url }}"
          class="header__action-btn"
          aria-label="My account"
        >
          {% render 'icon-user', class: 'icon' %}
        </a>
        
        {% comment %} CART {% endcomment %}
        <a
          href="{{ routes.cart_url }}"
          class="header__action-btn header__cart"
          aria-label="Cart: {{ cart.item_count }} items"
          data-cart-count
        >
          {% render 'icon-cart', class: 'icon' %}
          <span class="header__cart-count" data-cart-count-bubble>
            {{ cart.item_count }}
          </span>
        </a>
        
        {% comment %} MOBILE MENU TOGGLE {% endcomment %}
        <button
          class="header__menu-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          data-menu-toggle
          type="button"
        >
          <span class="hamburger"></span>
        </button>
      </div>
      
    </div>
  </div>
  
  {% comment %} SEARCH OVERLAY {% endcomment %}
  <div
    class="header__search-overlay"
    role="search"
    aria-label="Site search"
    data-search-overlay
    hidden
  >
    <div class="container">
      <form
        action="{{ routes.search_url }}"
        method="get"
        class="header__search-form"
        role="search"
      >
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.label' | t }}"
          class="header__search-input"
          autocomplete="off"
          required
        >
        <input type="hidden" name="type" value="product">
        <button
          type="submit"
          class="header__search-btn"
          aria-label="{{ 'general.search.submit' | t }}"
        >
          {% render 'icon-search', class: 'icon' %}
        </button>
        <button
          class="header__search-close"
          aria-label="{{ 'general.search.close' | t }}"
          data-search-close
          type="button"
        >
          {% render 'icon-close', class: 'icon' %}
        </button>
      </form>
    </div>
  </div>
  
  {% comment %} MOBILE NAVIGATION {% endcomment %}
  <div
    class="header__mobile-nav"
    role="navigation"
    aria-label="Mobile navigation"
    data-mobile-nav
    aria-hidden="true"
  >
    <div class="header__mobile-nav-inner">
      <ul class="header__mobile-nav-list">
        {% for block in section.blocks %}
          {% if block.type == 'menu_item' %}
            <li>
              <a href="{{ block.settings.link }}">
                {{ block.settings.title }}
              </a>
            </li>
          {% endif %}
        {% endfor %}
        
        <li class="header__mobile-nav-divider"></li>
        
        <li><a href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></li>
        <li><a href="{{ routes.contact_url }}">{{ 'general.contact.title' | t }}</a></li>
        
        {% if section.settings.show_faq_in_mobile %}
          <li><a href="{{ routes.page_url | append: '/faq' }}">{{ 'general.faq.title' | t }}</a></li>
        {% endif %}
      </ul>
    </div>
  </div>
  
  {% comment %} MOBILE NAV BACKDROP {% endcomment %}
  <div
    class="header__mobile-nav-backdrop"
    data-mobile-backdrop
    aria-hidden="true"
  ></div>
  
</header>

{% comment %} ========================================
  SECTION SCHEMA
  ======================================== {% endcomment %}
{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $75"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Link text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_faq_in_mobile",
      "label": "Show FAQ link in mobile menu",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Menu Item"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_dropdown",
          "label": "Show dropdown",
          "default": false
        },
        {
          "type": "header",
          "content": "Dropdown Column 1"
        },
        {
          "type": "text",
          "id": "dropdown_col_1_title",
          "label": "Column 1 heading"
        },
        {
          "type": "textarea",
          "id": "dropdown_col_1_links",
          "label": "Column 1 links",
          "info": "Each link on a new line: Label|/url/path"
        },
        {
          "type": "header",
          "content": "Dropdown Column 2"
        },
        {
          "type": "text",
          "id": "dropdown_col_2_title",
          "label": "Column 2 heading"
        },
        {
          "type": "textarea",
          "id": "dropdown_col_2_links",
          "label": "Column 2 links",
          "info": "Each link on a new line: Label|/url/path"
        },
        {
          "type": "header",
          "content": "Dropdown Column 3"
        },
        {
          "type": "text",
          "id": "dropdown_col_3_title",
          "label": "Column 3 heading"
        },
        {
          "type": "textarea",
          "id": "dropdown_col_3_links",
          "label": "Column 3 links",
          "info": "Each link on a new line: Label|/url/path"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "menu_item",
          "settings": {
            "title": "Women",
            "link": "/collections/women"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Men",
            "link": "/collections/men"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "title": "Kids",
            "link": "/collections/kids"
          }
        }
      ]
    }
  ]
}
{% endschema %}
